# webhook signing secret unless an approved partner documents one.
WHATSAPP_CLOUD_ENABLED="false"
WHATSAPP_COEXISTENCE_ENABLED="false"
WHATSAPP_CLOUD_BILLING_ENABLED="false"
# Required even when the master flag is enabled; an empty cohort fails closed.
WHATSAPP_CLOUD_ALLOWED_WORKSPACE_IDS=""
WHATSAPP_CLOUD_TRANSPORT="disabled"
WHATSAPP_APPROVED_PARTNER_ID=""
WHATSAPP_APPROVED_PARTNER_SOLUTION_ID=""
