DATABASE_URL="postgresql://connexa:connexa@localhost:5432/connexa?schema=public"
APP_URL="https://your-domain.example"
NEXT_PUBLIC_CONNEXA_LANDING_VIDEO_URL="https://www.youtube.com/watch?v=e5oyEIulVnA"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Connexa <you@gmail.com>"
SUPPORT_EMAIL="support@yourcompany.com"
EMAIL_BRAND_NAME="Connexa"
EMAIL_BRAND_TAGLINE="Shared workspace communication for modern teams."
APP_ENCRYPTION_KEY="replace-with-a-32-byte-secret"
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business / Embedded Signup v4 configuration ID.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Backward-compatible alias; prefer META_EMBEDDED_SIGNUP_CONFIG_ID.
META_CONFIG_ID=""
META_GRAPH_API_VERSION="v26.0"
# Backward-compatible alias; prefer META_GRAPH_API_VERSION.
META_GRAPH_VERSION=""
# Optional for the JavaScript SDK code-return flow. If configured, it must be
# HTTPS (except localhost development) and match Meta exactly.
META_REDIRECT_URI=""
META_CALLBACK_PUBLIC_BASE_URL="https://your-domain.example"
META_BUSINESS_ID=""
META_VERIFY_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
# Meta signs direct webhooks with META_APP_SECRET; do not configure a second
# webhook signing secret unless an approved partner documents one.
WHATSAPP_CLOUD_ENABLED="false"
WHATSAPP_COEXISTENCE_ENABLED="false"
WHATSAPP_CLOUD_BILLING_ENABLED="false"
# Required even when the master flag is enabled; an empty cohort fails closed.
WHATSAPP_CLOUD_ALLOWED_WORKSPACE_IDS=""
WHATSAPP_CLOUD_TRANSPORT="disabled"
WHATSAPP_APPROVED_PARTNER_ID=""
WHATSAPP_APPROVED_PARTNER_SOLUTION_ID=""
WHATSAPP_APPROVED_PARTNER_API_BASE_URL=""
WHATSAPP_APPROVED_PARTNER_WEBHOOK_SECRET=""
OUTBOUND_WORKER_TOKEN=""
OUTBOUND_WORKER_URL=""
OUTBOUND_WORKER_POLL_MS="3000"
OUTBOUND_WORKER_BATCH_SIZE="10"
OUTBOUND_WORKER_LABEL="connexa-worker-1"
PAYMENT_PROCESSING_TIMEOUT_MINUTES="20"
PAYMENT_RECONCILIATION_BATCH_SIZE="25"
BILLING_CLEANUP_INTERVAL_MS="60000"
SENDER_SERVICE_URL=""
SENDER_SERVICE_TOKEN=""
SENDER_SERVICE_HOST="127.0.0.1"
SENDER_SERVICE_PORT="3101"
WHATSAPP_RUNTIME_WATCHDOG_INTERVAL_MS="60000"
WHATSAPP_RUNTIME_HEALTH_TIMEOUT_MS="10000"
WHATSAPP_RUNTIME_HEALTH_FAILURE_THRESHOLD="3"
WHATSAPP_RECOVERY_BASE_MS="5000"
WHATSAPP_RECOVERY_MAX_MS="300000"
WHATSAPP_RECOVERY_WINDOW_MS="900000"
WHATSAPP_MAX_RECOVERY_ATTEMPTS="3"
SENDER_WATCHDOG_MAX_FAILURES="3"
WHATSAPP_HISTORY_OPERATION_TIMEOUT_MS="30000"
WHATSAPP_HISTORY_CHAT_TIMEOUT_MS="45000"
WHATSAPP_HISTORY_SYNC_WATCHDOG_MS="1200000"
WHATSAPP_BOOTSTRAP_CHAT_BATCH="5"
WHATSAPP_BOOTSTRAP_MESSAGE_LIMIT="20"
WHATSAPP_BOOTSTRAP_START_DELAY_MS="0"
WHATSAPP_HISTORY_CHAT_WORKLIST_TTL_MS="60000"
WHATSAPP_PAIRING_HISTORY_DEFERRAL_MS="5000"
WHATSAPP_PAIRING_HISTORY_MAX_DEFERRAL_MS="30000"
WHATSAPP_HISTORY_WORK_UNIT_CHATS="5"
# Incremental reconciliation is deliberately shadowed until its counters and
# checkpoints have been observed in the target environment. Use "on" only
# after validation; "off" restores the legacy authoritative scan.
WHATSAPP_INCREMENTAL_SYNC_MODE="shadow"
WHATSAPP_INCREMENTAL_ROLLOUT_PERCENT="10"
WHATSAPP_ROUTINE_RECONCILIATION_MS="1800000"
WHATSAPP_DEEP_AUDIT_MS="86400000"
WHATSAPP_INCREMENTAL_OVERLAP_MESSAGES="50"
WHATSAPP_HISTORY_GLOBAL_CONCURRENCY="1"
WHATSAPP_HISTORY_BATCH_WALL_MS="60000"
WHATSAPP_HISTORY_LEASE_TTL_MS="120000"
WHATSAPP_HISTORY_SCHEDULE_JITTER_MS="30000"
WHATSAPP_PROFILE_PHOTO_CACHE_TTL_MS="300000"
WHATSAPP_PROFILE_PHOTO_MISS_CACHE_TTL_MS="30000"
WHATSAPP_CLIENT_TEARDOWN_TIMEOUT_MS="15000"
WHATSAPP_HEALTH_CACHE_TTL_MS="5000"
WHATSAPP_INBOX_HEALTH_TIMEOUT_MS="300"
INBOX_WEB_PUSH_ENABLED="true"
INBOX_WEB_PUSH_VAPID_PUBLIC_KEY=""
INBOX_WEB_PUSH_VAPID_PRIVATE_KEY=""
INBOX_WEB_PUSH_VAPID_SUBJECT="mailto:support@your-domain.example"
# Optional browser overrides. Candidate images bundle Puppeteer's matched Chrome
# for Testing and set WHATSAPP_WEB_EXECUTABLE_PATH to it by default. Set the path
# to /usr/bin/chromium only for rollback. Set WHATSAPP_WEB_USER_AGENT to "native"
# to use the matched browser's real user agent, leave it blank for the
# whatsapp-web.js Chrome 101 default, or provide an explicit user-agent string.
WHATSAPP_WEB_EXECUTABLE_PATH=
WHATSAPP_WEB_USER_AGENT=
