generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industryType IndustryType @default(PROPERTY)
  plan      String   @default("trial")
  trialEndsAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]
  automationRules AutomationRule[]
  contacts  Contact[]
  notes     Note[]
  quickReplies QuickReply[]
  campaignDrafts CampaignDraft[]
  campaignRuns CampaignRun[]
  campaignRunRecipients CampaignRunRecipient[]
  leads     Lead[]
  leadActivities LeadActivity[]
  products  Product[]
  conversations Conversation[]
  conversationAuditEvents ConversationAuditEvent[]
  sessions  Session[]
  invites   Invite[]
  whatsAppChannel WhatsAppChannel?
  appointments Appointment[]
  outboundMessageJobs OutboundMessageJob[]
  automationSettings WorkspaceAutomationSettings?
  automationStates ConversationAutomationState[]
  automationJobs AutomationJob[]
  ruleExecutions ConversationRuleExecution[]
  workflows AutomationWorkflow[]
  workflowAssignmentCursors AutomationWorkflowAssignmentCursor[]
  mediaAssets WorkspaceMediaAsset[]
  whatsAppMessageEnvelopes WhatsAppMessageEnvelope[]
  whatsAppRuntimeEvents WhatsAppRuntimeEvent[]
  packageSubscriptions WorkspacePackageSubscription[]
  paymentTransactions PaymentTransaction[]
}

model Account {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agents          Agent[]
}

model Agent {
  id          String      @id @default(cuid())
  accountId   String?
  workspaceId String
  name        String
  email       String
  phone       String?
  passwordHash String?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  inviteAcceptedAt DateTime?
  role        AgentRole   @default(AGENT)
  status      AgentStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]      @relation("LeadOwner")
  createdLeadActivities LeadActivity[] @relation("LeadActivityCreator")
  ownedContacts Contact[] @relation("ContactOwner")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  contactTeammates ContactTeammate[]
  conversationTeammates ConversationTeammate[]
  conversationAuditEvents ConversationAuditEvent[] @relation("ConversationAuditActor")
  conversationAuditEventsFrom ConversationAuditEvent[] @relation("ConversationAuditFromAssignee")
  conversationAuditEventsTo ConversationAuditEvent[] @relation("ConversationAuditToAssignee")
  sentMessages Message[] @relation("MessageSender")
  notes       Note[]
  sessions    Session[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvites Invite[] @relation("InviteSender")
  availabilityRules AgentAvailabilityRule[]
  availabilityOverrides AgentAvailabilityOverride[]
  appointments Appointment[] @relation("AppointmentOwner")
  managedWhatsAppChannel WhatsAppChannel? @relation("WhatsAppChannelConnector")
  uploadedMediaAssets WorkspaceMediaAsset[]
  createdCampaignDrafts CampaignDraft[] @relation("CampaignDraftCreator")
  createdCampaignRuns CampaignRun[] @relation("CampaignRunCreator")
  workflowAssignmentCursors AutomationWorkflowAssignmentCursor[] @relation("WorkflowAssignmentCursorAgent")

  @@index([accountId])
  @@index([workspaceId])
  @@unique([workspaceId, email])
}

model AgentAvailabilityRule {
  id        String   @id @default(cuid())
  agentId    String
  dayOfWeek Int
  enabled   Boolean  @default(false)
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dayOfWeek])
  @@index([agentId, dayOfWeek])
}

model AgentAvailabilityOverride {
  id        String   @id @default(cuid())
  agentId    String
  type      AvailabilityOverrideType
  startAt   DateTime
  endAt     DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startAt, endAt])
}

model Session {
  id          String   @id @default(cuid())
  agentId      String
  workspaceId String
  tokenHash   String   @unique
  remember    Boolean  @default(false)
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([workspaceId, expiresAt])
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     PlatformSession[]
}

model PlatformSession {
  id         String        @id @default(cuid())
  adminId    String
  tokenHash  String        @unique
  expiresAt  DateTime
  lastUsedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model PlatformConfig {
  id                String   @id @default("platform")
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean  @default(false)
  smtpUser          String?
  smtpPass          String?
  smtpFrom          String?
  supportEmail      String?
  emailBrandName    String?
  emailBrandTagline String?
  billplzApiKey     String?
  billplzXSignatureKey String?
  billplzCollectionId String?
  billplzSandbox    Boolean  @default(false)
  automationWorkflowIdleHours   Int      @default(24)
  automationWorkflowExpireHours Int      @default(72)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  packageConfigs    PlatformPackageConfig[]
}

model PlatformPackageConfig {
  id                  String         @id @default(cuid())
  platformId          String         @default("platform")
  packageKey          String         @unique
  isVisible           Boolean        @default(true)
  displayOrder        Int            @default(0)
  priceAmount         Decimal?       @db.Decimal(10, 2)
  maxOutboundMessages Int?
  maxActiveContacts   Int?
  maxActiveAutomations Int?
  maxWhatsAppCampaigns Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  platform            PlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId, displayOrder])
}

model Package {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  priceAmount   Decimal? @db.Decimal(10, 2)
  currency      String?
  billingPeriod BillingPeriod?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions WorkspacePackageSubscription[]
}

model WorkspacePackageSubscription {
  id              String             @id @default(cuid())
  workspaceId     String
  packageId       String
  status          SubscriptionStatus
  subscribedPrice Decimal?           @db.Decimal(10, 2)
  currency        String?
  billingPeriod   BillingPeriod?
  startedAt       DateTime
  endedAt         DateTime?
  nextBillingAt   DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  package         Package            @relation(fields: [packageId], references: [id])
  transactions    PaymentTransaction[]

  @@index([workspaceId, status])
  @@index([workspaceId, startedAt])
  @@index([packageId])
}

model PaymentTransaction {
  id                String                 @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  amount            Decimal                @db.Decimal(10, 2)
  currency          String                 @default("MYR")
  status            PaymentStatus
  provider          String?
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  subscription      WorkspacePackageSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@index([workspaceId, createdAt])
  @@index([provider, providerReference])
}

model PendingWorkspaceCheckout {
  id                  String   @id @default(cuid())
  plan                String
  name                String
  email               String
  workspaceName       String
  passwordHash        String
  remember            Boolean  @default(false)
  provider            String?
  providerReference   String?  @unique
  providerCheckoutUrl String?
  status              String   @default("PENDING")
  paidAt              DateTime?
  completedAt         DateTime?
  workspaceId         String?
  agentId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  agentId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
}

model LoginChallengeUse {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        AgentRole @default(AGENT)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   Agent     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model Contact {
  id              String   @id @default(cuid())
  workspaceId     String
  ownerId         String?
  displayName     String
  syncedDisplayName String?
  displayNameManualOverride Boolean @default(false)
  phone           String
  photoUrl        String?
  email           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  emailManualOverride Boolean @default(false)
  status          ContactStatus @default(ACTIVE)
  isHotLead       Boolean  @default(false)
  tags            String
  syncedTags      String?
  tagsManualOverride Boolean @default(false)
  lastInteractionAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           Agent?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teammates       ContactTeammate[]
  conversations   Conversation[]
  campaignRecipients CampaignRunRecipient[]
  leads           Lead[]
  notes           Note[]
  appointments    Appointment[]

  @@index([workspaceId, lastInteractionAt])
  @@index([ownerId])
  @@unique([workspaceId, phone])
}

model Conversation {
  id                String   @id @default(cuid())
  workspaceId       String
  contactId         String
  assigneeId        String?
  whatsAppRemoteId  String?
  subject           String?
  status            ConversationStatus @default(OPEN)
  snoozedUntil      DateTime?
  unreadCount       Int      @default(0)
  isHotLead         Boolean  @default(false)
  lastMessagePreview String?
  lastMessageAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact           Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee          Agent? @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teammates         ConversationTeammate[]
  messages          Message[]
  notes             Note[]
  appointments      Appointment[]
  automationState   ConversationAutomationState?
  ruleExecutions    ConversationRuleExecution[]
  automationJobs    AutomationJob[]
  outboundMessageJobs OutboundMessageJob[]
  campaignRecipients CampaignRunRecipient[]
  auditEvents       ConversationAuditEvent[]
  whatsAppMessageEnvelopes WhatsAppMessageEnvelope[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([contactId])
  @@index([assigneeId])
  @@index([whatsAppRemoteId])
}

model ContactTeammate {
  contactId  String
  agentId    String
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([contactId, agentId])
  @@index([agentId])
}

model ConversationTeammate {
  conversationId String
  agentId        String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([conversationId, agentId])
  @@index([agentId])
}

model ConversationAuditEvent {
  id             String                     @id @default(cuid())
  workspaceId    String
  conversationId String
  actorId        String
  type           ConversationAuditEventType
  fromAssigneeId String?
  toAssigneeId   String?
  createdAt      DateTime                   @default(now())
  workspace      Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          Agent                      @relation("ConversationAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  fromAssignee   Agent?                     @relation("ConversationAuditFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: SetNull)
  toAssignee     Agent?                     @relation("ConversationAuditToAssignee", fields: [toAssigneeId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  providerMessageId String? @unique
  replyToMessageId String?
  direction      MessageDirection
  body           String
  attachmentName String?
  attachmentUrl  String?
  attachmentMimeType String?
  rawPayload     String?
  sentAt         DateTime @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Agent? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyToMessage Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")
  outboundJob    OutboundMessageJob?
  whatsAppEnvelope WhatsAppMessageEnvelope?

  @@index([conversationId, sentAt])
  @@index([replyToMessageId])
}

model WhatsAppMessageEnvelope {
  id                   String   @id @default(cuid())
  workspaceId          String
  conversationId       String?
  messageId            String?  @unique
  providerMessageId    String   @unique
  from                 String?
  to                   String?
  author               String?
  ack                  Int?
  messageTimestamp     DateTime?
  messageType          String?
  body                 String?
  fromMe               Boolean  @default(false)
  hasMedia             Boolean  @default(false)
  isForwarded          Boolean?
  isStatus             Boolean?
  broadcast            Boolean?
  deviceType           String?
  hasQuotedMsg         Boolean?
  mentionedIdsJson     Json?
  groupMentionsJson    Json?
  linksJson            Json?
  selectedButtonId     String?
  selectedRowId        String?
  mediaMimeType        String?
  mediaFilename        String?
  mediaFilesize        Int?
  mediaWidth           Int?
  mediaHeight          Int?
  mediaDurationSeconds Int?
  mediaCaption         String?
  mediaUrl             String?
  mediaStoragePath     String?
  latitude             Float?
  longitude            Float?
  locationDescription  String?
  quotedMessageId      String?
  quotedBody           String?
  contactId            String?
  contactName          String?
  contactPushname      String?
  contactNumber        String?
  chatId               String?
  chatName             String?
  chatIsGroup          Boolean?
  contactSnapshotJson  Json?
  chatSnapshotJson     Json?
  rawJson              Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation         Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message              Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageTimestamp])
  @@index([contactNumber])
  @@index([chatId])
}

model OutboundMessageJob {
  id                    String   @id @default(cuid())
  workspaceId           String
  conversationId        String
  messageId             String   @unique
  campaignRunId         String?
  campaignRunRecipientId String?
  status                OutboundMessageJobStatus @default(PENDING)
  to                    String
  body                  String
  attachmentMimeType    String?
  attachmentName        String?
  attachmentUrl         String?
  quotedProviderMessageId String?
  interactiveButtonsJson String?
  interactiveListButtonText String?
  interactiveListOptionsJson String?
  attempts              Int      @default(0)
  maxAttempts           Int      @default(5)
  availableAt           DateTime @default(now())
  lockedAt              DateTime?
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message               Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaignRun           CampaignRun? @relation(fields: [campaignRunId], references: [id], onDelete: SetNull)
  campaignRunRecipient  CampaignRunRecipient? @relation(fields: [campaignRunRecipientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, availableAt])
  @@index([conversationId, availableAt])
  @@index([campaignRunId, availableAt])
  @@index([campaignRunRecipientId, availableAt])
}

model OutboundWorkerHeartbeat {
  id          String   @id @default(cuid())
  workspaceId String
  workerLabel String
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, workerLabel])
  @@index([workspaceId, lastSeenAt])
}

model Note {
  id             String   @id @default(cuid())
  workspaceId    String
  contactId      String?
  conversationId String?
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         Agent @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model QuickReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  shortcut    String
  category    String   @default("General")
  body        String
  mediaAssetIdsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category, title])
  @@unique([workspaceId, shortcut])
}

model CampaignDraft {
  id                     String   @id @default(cuid())
  workspaceId            String
  createdById            String?
  name                   String
  messageBody            String
  scheduleAt             DateTime?
  selectedContactIdsJson String?
  selectedAttachmentIdsJson String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy              Agent?    @relation("CampaignDraftCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt])
  @@index([createdById, updatedAt])
}

model CampaignRun {
  id                     String   @id @default(cuid())
  workspaceId            String
  createdById            String?
  name                   String
  messageBody            String
  scheduleAt             DateTime?
  selectedAttachmentIdsJson String?
  recipientCount         Int      @default(0)
  queuedJobCount         Int      @default(0)
  excludedCount          Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy              Agent?    @relation("CampaignRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients             CampaignRunRecipient[]
  outboundMessageJobs    OutboundMessageJob[]

  @@index([workspaceId, createdAt])
  @@index([createdById, createdAt])
}

model CampaignRunRecipient {
  id              String   @id @default(cuid())
  workspaceId     String
  campaignRunId   String
  contactId       String
  conversationId  String?
  status          CampaignRunRecipientStatus
  reason          String?
  queuedJobCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignRun     CampaignRun @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)
  contact         Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  outboundMessageJobs OutboundMessageJob[]

  @@index([workspaceId, createdAt])
  @@index([campaignRunId, createdAt])
  @@index([contactId, createdAt])
}

model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  triggerType AutomationTriggerType
  matchType   AutomationMatchType @default(CONTAINS)
  keyword     String?
  replyBody   String
  replyMediaAssetId String?
  replyMediaAssetIdsJson String?
  workflowId  String?
  addTags     String?
  priority    Int @default(100)
  cooldownMinutes Int @default(360)
  stopAfterMatch Boolean @default(false)
  businessHoursOnly Boolean @default(false)
  followUpDelayMinutes Int?
  followUpReplyBody String?
  followUpMediaAssetId String?
  followUpMediaAssetIdsJson String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    AutomationWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  replyMediaAsset WorkspaceMediaAsset? @relation("AutomationRuleReplyMediaAsset", fields: [replyMediaAssetId], references: [id], onDelete: SetNull)
  followUpMediaAsset WorkspaceMediaAsset? @relation("AutomationRuleFollowUpMediaAsset", fields: [followUpMediaAssetId], references: [id], onDelete: SetNull)
  executions  ConversationRuleExecution[]
  jobs        AutomationJob[]

  @@index([workspaceId, triggerType, enabled, priority])
  @@index([workflowId])
  @@index([replyMediaAssetId])
  @@index([followUpMediaAssetId])
}

model WorkspaceMediaAsset {
  id           String   @id @default(cuid())
  workspaceId   String
  uploadedByAgentId String?
  title        String
  originalName String
  storagePath  String
  publicUrl    String
  mimeType     String
  kind         MediaAssetKind
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedByAgent Agent? @relation(fields: [uploadedByAgentId], references: [id], onDelete: SetNull)
  replyRules   AutomationRule[] @relation("AutomationRuleReplyMediaAsset")
  followUpRules AutomationRule[] @relation("AutomationRuleFollowUpMediaAsset")

  @@index([workspaceId, kind, createdAt])
  @@index([uploadedByAgentId])
}

model WorkspaceAutomationSettings {
  id        String   @id @default(cuid())
  workspaceId String @unique
  timezone  String   @default("Asia/Kuala_Lumpur")
  businessHoursEnabled Boolean @default(false)
  businessHoursJson String?
  awayReplyEnabled Boolean @default(false)
  awayReplyBody String?
  awayReplyCooldownMinutes Int @default(720)
  humanTakeoverPauseMinutes Int @default(240)
  regexEnabled Boolean @default(false)
  decisionFlowEnabled Boolean @default(false)
  decisionFlowQuestion String?
  decisionFlowYesKeywords String?
  decisionFlowNoKeywords String?
  decisionFlowYesReply String?
  decisionFlowNoReply String?
  decisionFlowFallbackReply String?
  decisionFlowYesTags String?
  decisionFlowNoTags String?
  workflowFlowEnabled Boolean @default(false)
  activeWorkflowId String?
  propertyFlowEnabled Boolean @default(false)
  propertyFlowPromptPurpose String?
  propertyFlowPromptArea String?
  propertyFlowPromptBudget String?
  propertyFlowCompleteReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AutomationWorkflow {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  definitionJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignmentCursors AutomationWorkflowAssignmentCursor[]
  rules        AutomationRule[]

  @@index([workspaceId, updatedAt])
}

model AutomationWorkflowAssignmentCursor {
  id                  String   @id @default(cuid())
  workspaceId         String
  workflowId          String
  stepId              String
  nextIndex           Int      @default(0)
  lastAssignedAgentId String?
  lastAssignedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow            AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  lastAssignedAgent   Agent?   @relation("WorkflowAssignmentCursorAgent", fields: [lastAssignedAgentId], references: [id], onDelete: SetNull)

  @@unique([workflowId, stepId])
  @@index([workspaceId, workflowId])
  @@index([lastAssignedAgentId])
}

model ConversationAutomationState {
  id        String   @id @default(cuid())
  workspaceId String
  conversationId String @unique
  welcomeSentAt DateTime?
  awayReplySentAt DateTime?
  automationPausedUntil DateTime?
  activeFlowKey String?
  activeFlowStep String?
  flowStateJson String?
  lastAutoReplyAt DateTime?
  lastMatchedRuleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, automationPausedUntil])
}

model ConversationRuleExecution {
  id        String   @id @default(cuid())
  workspaceId String
  conversationId String
  ruleId String
  lastTriggeredAt DateTime
  triggerCount Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([conversationId, ruleId])
  @@index([workspaceId, lastTriggeredAt])
}

model AutomationJob {
  id        String   @id @default(cuid())
  workspaceId String
  conversationId String
  leadId String?
  ruleId String?
  jobType AutomationJobType
  status AutomationJobStatus @default(PENDING)
  runAt DateTime
  payloadJson String
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  rule AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, runAt])
  @@index([conversationId, runAt])
}

model WhatsAppChannel {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  phoneNumberId         String?  @unique
  businessAccountId     String?
  accessTokenCiphertext String?
  appSecretCiphertext   String?
  verifyTokenHash       String?  @unique
  accessTokenLastFour   String?
  appSecretLastFour     String?
  verifyTokenLastFour   String?
  connectedByAgentId    String?  @unique
  sessionClientId       String?  @unique
  connectionStatus      String   @default("DISCONNECTED")
  displayName           String?
  phoneNumber           String?
  qrCodeDataUrl         String?
  qrCodeUpdatedAt       DateTime?
  lastError             String?
  connectedAt           DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedByAgent      Agent?    @relation("WhatsAppChannelConnector", fields: [connectedByAgentId], references: [id], onDelete: SetNull)

  @@index([connectionStatus])
}

model WhatsAppRuntimeEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  sessionClientId String?
  eventType       String
  message         String?
  metadataJson    String?
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model Lead {
  id               String    @id @default(cuid())
  workspaceId      String
  contactId        String?
  // Deprecated: product linkage is optional and property-specific. Prefer customData.productId/productInterest.
  productId        String?
  ownerId          String?
  name             String
  phone            String
  source           LeadSource
  sourceDetail     String?
  project          String
  stage            LeadStage @default(NEW_LEAD)
  pipelineId       String?
  pipelineStageKey String?
  budget           Int?
  preferredArea    String?
  financingStatus  String?
  value            Int?
  currency         String    @default("MYR")
  note             String?
  lastMessage      String?
  responseMinutes  Int?
  lastActivityAt   DateTime  @default(now())
  siteVisitAt      DateTime?
  // Deprecated: industry-specific lead details now live in customData.
  industryType     IndustryType @default(PROPERTY)
  priority         LeadPriority @default(MEDIUM)
  nextActionAt     DateTime?
  nextActionType   LeadNextActionType?
  nextActionNote   String?
  lostReason       String?
  customData       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner            Agent?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  automationJobs   AutomationJob[]
  activities       LeadActivity[]

  @@index([workspaceId, industryType, stage])
  @@index([workspaceId, pipelineStageKey])
  @@index([contactId])
  @@index([ownerId])
  @@index([nextActionAt])
  @@index([productId])
}

model LeadActivity {
  id            String           @id @default(cuid())
  workspaceId   String
  leadId        String
  type          LeadActivityType
  title         String
  description   String?
  metadata      String?
  createdById   String?
  createdAt     DateTime         @default(now())
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy     Agent?           @relation("LeadActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([createdById])
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  area        String?
  location    String?
  mapUrl      String?
  websiteUrl  String?
  financing   String? // financing notes
  financingTags String? // JSON array
  brochureName String?
  brochureUrl  String?
  priceMin    Int?
  priceMax    Int?
  imageUrls   String? // JSON array
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]
  appointments Appointment[]

  @@index([workspaceId])
}

model Appointment {
  id             String            @id @default(cuid())
  workspaceId     String
  contactId       String
  leadId          String?
  productId       String?
  conversationId  String?
  ownerId         String?
  title           String
  type            AppointmentType  @default(SITE_VISIT)
  status          AppointmentStatus @default(SCHEDULED)
  startAt         DateTime
  endAt           DateTime
  location        String?
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead            Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  owner           Agent?            @relation("AppointmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
  @@index([contactId, startAt])
  @@index([ownerId, startAt])
  @@index([leadId, startAt])
  @@index([productId, startAt])
  @@index([conversationId, startAt])
}

