model WhatsAppHistoryLease {
  channelId   String          @id
  workspaceId String
  ownerId     String
  generation  Int             @default(1)
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([expiresAt])
}

// Cloud API state is deliberately separate from whatsapp-web.js session state.
// Every record is tenant scoped and all live Cloud behavior remains feature-flagged.
model MetaOnboardingAttempt {
  id                      String          @id @default(cuid())
  workspaceId             String
  channelId               String
  initiatedByAgentId      String
  stateHash               String          @unique
  configId                String
  mode                    String
  status                  String          @default("PENDING")
  authorizationCiphertext String?
  returnedAssetsJson      String?
  failureCode             String?
  expiresAt               DateTime
  consumedAt              DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel                 WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channelId, status])
  @@index([expiresAt, status])
}

model MetaWebhookEvent {
  id                  String          @id @default(cuid())
  workspaceId         String
  channelId           String
  provider            String
  integrationIdentity String
  waacId              String?
  messagingAccountId  String?
  phoneNumberId       String?
  idempotencyKey      String
  eventType           String
  payloadDigest       String
  providerOccurredAt  DateTime?
  receivedAt          DateTime        @default(now())
  processingStatus    String          @default("RECEIVED")
  processedAt         DateTime?
  lastErrorCode       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel             WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([provider, integrationIdentity, idempotencyKey])
  @@index([workspaceId, processingStatus, receivedAt])
  @@index([channelId, providerOccurredAt])
}

model WhatsAppCoexistenceSyncJob {
  id                 String          @id @default(cuid())
  workspaceId        String
  channelId          String
  syncType           String
  requestId          String?
  explicitConsentAt  DateTime
  consentedByAgentId String
  status             String          @default("PENDING")
  expiresAt          DateTime
  progressJson       String?
  lastErrorCode      String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel            WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channelId, status])
  @@index([expiresAt, status])
}

model TenantFundingAccount {
  id                            String                   @id @default(cuid())
  workspaceId                   String                   @unique
  billingRoute                  String                   @default("unconfigured")
  providerIdentity              String?
  verified                      Boolean                  @default(false)
  allocationReferenceCiphertext String?
  billingCurrency               String                   @default("MYR")
  prepaidBalance                Decimal                  @default(0) @db.Decimal(18, 6)
  monthlyCap                    Decimal?                 @db.Decimal(18, 6)
  spentThisPeriod               Decimal                  @default(0) @db.Decimal(18, 6)
  periodStartedAt               DateTime?
  gracePolicy                   String                   @default("BLOCK_OUTBOUND")
  verifiedAt                    DateTime?
  verifiedByAdminId             String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  workspace                     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reservations                  UsageCreditReservation[]

  @@index([billingRoute, verified])
}

model UsageCreditReservation {
  id               String               @id @default(cuid())
  workspaceId      String
  channelId        String
  fundingAccountId String
  idempotencyKey   String
  currency         String
  estimatedAmount  Decimal              @db.Decimal(18, 6)
  settledAmount    Decimal?             @db.Decimal(18, 6)
  status           String               @default("RESERVED")
  expiresAt        DateTime
  settledAt        DateTime?
  releasedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel          WhatsAppChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fundingAccount   TenantFundingAccount @relation(fields: [fundingAccountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([fundingAccountId, status, expiresAt])
  @@index([channelId, createdAt])
}

model WhatsAppUsageLedger {
  id                   String          @id @default(cuid())
  workspaceId          String
  channelId            String
  reservationId        String?
  messageId            String?
  providerReference    String?
  direction            String
  category             String
  destinationMarket    String?
  currency             String
  rateCardVersion      String
  rateEffectiveAt      DateTime
  estimatedCost        Decimal         @default(0) @db.Decimal(18, 6)
  finalCost            Decimal?        @db.Decimal(18, 6)
  reconciliationStatus String          @default("ESTIMATED")
  deliveryResult       String?
  billingPeriodKey     String
  occurredAt           DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel              WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, providerReference, category, billingPeriodKey])
  @@index([workspaceId, billingPeriodKey, category])
  @@index([channelId, occurredAt])
  @@index([reservationId])
  @@index([reconciliationStatus, occurredAt])
}

model WhatsAppPhonePairingAudit {
  id                    String   @id @default(cuid())
  workspaceId           String
  channelId             String
  agentId               String
  phoneNumberCiphertext String
  pairingCodeCiphertext String
  maskedPhoneNumber     String
  status                String   @default("GENERATED")
  createdAt             DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
}

model InboxNewConversationRequest {
  id                      String          @id @default(cuid())
  workspaceId             String
  agentId                 String
  channelId               String
  idempotencyKey          String
  phone                   String
  displayName             String?
  messageBody             String
  status                  String
  providerMessageId       String?
  contactId               String?
  conversationId          String?
  messageId               String?
  wasExistingContact      Boolean?
  wasExistingConversation Boolean?
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent                   Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel                 WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([channelId, createdAt])
}

model MessageUsageLog {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  accountId    String?          @map("account_id")
  provider     String
  messageType  String           @map("message_type")
  costEstimate Decimal          @default(0) @map("cost_estimate") @db.Decimal(12, 4)
  timestamp    DateTime         @default(now())
  createdAt    DateTime         @default(now()) @map("created_at")
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      WhatsAppChannel? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, timestamp])
  @@index([accountId, timestamp])
  @@index([provider, timestamp])
  @@index([messageType, timestamp])
  @@map("message_usage_logs")
}

model WhatsAppRuntimeEvent {
  id              String    @id @default(cuid())
  workspaceId     String
  sessionClientId String?
  eventType       String
  message         String?
  metadataJson    String?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model Lead {
  id               String              @id @default(cuid())
  workspaceId      String
  contactId        String?
  // Deprecated: product linkage is optional and property-specific. Prefer customData.productId/productInterest.
  productId        String?
  ownerId          String?
  name             String
  phone            String
  source           LeadSource
  sourceDetail     String?
  project          String
  stage            LeadStage           @default(NEW_LEAD)
  pipelineId       String?
  pipelineStageKey String?
  budget           Int?
  preferredArea    String?
  financingStatus  String?
  value            Int?
  currency         String              @default("MYR")
  note             String?
  lastMessage      String?
  responseMinutes  Int?
  lastActivityAt   DateTime            @default(now())
  siteVisitAt      DateTime?
  // Deprecated: industry-specific lead details now live in customData.
  industryType     IndustryType        @default(PROPERTY)
  priority         LeadPriority        @default(MEDIUM)
  nextActionAt     DateTime?
  nextActionType   LeadNextActionType?
  nextActionNote   String?
  lostReason       String?
  customData       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product          Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner            Agent?              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  automationJobs   AutomationJob[]
  activities       LeadActivity[]

  @@index([workspaceId, industryType, stage])
  @@index([workspaceId, pipelineStageKey])
  @@index([contactId])
  @@index([ownerId])
  @@index([nextActionAt])
  @@index([productId])
}

model LeadActivity {
  id          String           @id @default(cuid())
  workspaceId String
  leadId      String
  type        LeadActivityType
  title       String
  description String?
  metadata    String?
  createdById String?
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy   Agent?           @relation("LeadActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([createdById])
}

model Product {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  area          String?
  location      String?
  mapUrl        String?
  websiteUrl    String?
  financing     String? // financing notes
  financingTags String? // JSON array
  brochureName  String?
  brochureUrl   String?
  priceMin      Int?
  priceMax      Int?
  imageUrls     String? // JSON array
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads        Lead[]
  appointments Appointment[]

  @@index([workspaceId])
}

model Appointment {
  id             String            @id @default(cuid())
  workspaceId    String
  contactId      String
  leadId         String?
  productId      String?
  conversationId String?
  ownerId        String?
  title          String
  type           AppointmentType   @default(SITE_VISIT)
  status         AppointmentStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime
  location       String?
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  owner          Agent?            @relation("AppointmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
  @@index([contactId, startAt])
  @@index([ownerId, startAt])
  @@index([leadId, startAt])
  @@index([productId, startAt])
  @@index([conversationId, startAt])
}

