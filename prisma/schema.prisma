generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industryType IndustryType @default(PROPERTY)
  plan      String   @default("trial")
  mediaLibraryUsedBytes BigInt @default(0)
  trialEndsAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]
  automationRules AutomationRule[]
  contacts  Contact[]
  notes     Note[]
  quickReplies QuickReply[]
  campaignDrafts CampaignDraft[]
  campaignRuns CampaignRun[]
  campaignRunRecipients CampaignRunRecipient[]
  leads     Lead[]
  leadActivities LeadActivity[]
  products  Product[]
  conversations Conversation[]
  conversationAuditEvents ConversationAuditEvent[]
  sessions  Session[]
  invites   Invite[]
  whatsAppChannels WhatsAppChannel[]
  appointments Appointment[]
  outboundMessageJobs OutboundMessageJob[]
  automationSettings WorkspaceAutomationSettings?
  automationStates ConversationAutomationState[]
  automationJobs AutomationJob[]
  ruleExecutions ConversationRuleExecution[]
  workflows AutomationWorkflow[]
  workflowAssignmentCursors AutomationWorkflowAssignmentCursor[]
  mediaAssets WorkspaceMediaAsset[]
  whatsAppMessageEnvelopes WhatsAppMessageEnvelope[]
  whatsAppRuntimeEvents WhatsAppRuntimeEvent[]
  messageUsageLogs MessageUsageLog[]
  packageSubscriptions WorkspacePackageSubscription[]
  paymentTransactions PaymentTransaction[]
  pendingPackageUpgrades PendingWorkspacePackageUpgrade[]
  billingProfile WorkspaceBillingProfile?
  invoices Invoice[]
  billingHistories BillingHistory[]
  emailLogs EmailLog[]
  contactImports ContactImport[]
  inboxNewConversationRequests InboxNewConversationRequest[]
  rememberSessions RememberSession[]
}

model Account {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agents          Agent[]
  browserPushSubscriptions BrowserPushSubscription[]
}

model Agent {
  id          String      @id @default(cuid())
  accountId   String?
  workspaceId String
  name        String
  email       String
  phone       String?
  inboxNotificationSoundsMuted Boolean @default(false)
  inboxDesktopNotificationsPromptDismissedAt DateTime?
  passwordHash String?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  inviteAcceptedAt DateTime?
  role        AgentRole   @default(AGENT)
  status      AgentStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedPackageUpgrades PendingWorkspacePackageUpgrade[]
  leads       Lead[]      @relation("LeadOwner")
  createdLeadActivities LeadActivity[] @relation("LeadActivityCreator")
  ownedContacts Contact[] @relation("ContactOwner")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  snoozedConversations Conversation[] @relation("ConversationSnoozedBy")
  contactTeammates ContactTeammate[]
  conversationTeammates ConversationTeammate[]
  conversationAuditEvents ConversationAuditEvent[] @relation("ConversationAuditActor")
  conversationAuditEventsFrom ConversationAuditEvent[] @relation("ConversationAuditFromAssignee")
  conversationAuditEventsTo ConversationAuditEvent[] @relation("ConversationAuditToAssignee")
  sentMessages Message[] @relation("MessageSender")
  notes       Note[]
  sessions    Session[]
  rememberSessions RememberSession[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvites Invite[] @relation("InviteSender")
  availabilityRules AgentAvailabilityRule[]
  availabilityOverrides AgentAvailabilityOverride[]
  appointments Appointment[] @relation("AppointmentOwner")
  managedWhatsAppChannels WhatsAppChannel[] @relation("WhatsAppChannelConnector")
  uploadedMediaAssets WorkspaceMediaAsset[]
  createdCampaignDrafts CampaignDraft[] @relation("CampaignDraftCreator")
  createdCampaignRuns CampaignRun[] @relation("CampaignRunCreator")
  workflowAssignmentCursors AutomationWorkflowAssignmentCursor[] @relation("WorkflowAssignmentCursorAgent")
  contactImports ContactImport[] @relation("ContactImportUploader")
  inboxNewConversationRequests InboxNewConversationRequest[]
  browserPushSubscriptions BrowserPushSubscription[] @relation("BrowserPushSubscriptionAgent")
  userSecurityAuditLogs UserSecurityAuditLog[]

  @@index([accountId])
  @@index([workspaceId])
  @@unique([workspaceId, email])
}

model BrowserPushSubscription {
  id                  String   @id @default(cuid())
  accountId           String?
  agentId             String
  endpoint            String   @unique
  p256dhKey           String
  authKey             String
  userAgent           String?
  enabled             Boolean  @default(true)
  lastSuccessfulSendAt DateTime?
  lastFailureAt       DateTime?
  lastFailureCode     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  account             Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agent               Agent    @relation("BrowserPushSubscriptionAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([accountId, enabled])
  @@index([agentId, enabled])
}

model AgentAvailabilityRule {
  id        String   @id @default(cuid())
  agentId    String
  dayOfWeek Int
  enabled   Boolean  @default(false)
  allDay    Boolean  @default(false)
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dayOfWeek])
  @@index([agentId, dayOfWeek])
}

model AgentAvailabilityOverride {
  id        String   @id @default(cuid())
  agentId    String
  type      AvailabilityOverrideType
  startAt   DateTime
  endAt     DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startAt, endAt])
}

model Session {
  id          String   @id @default(cuid())
  agentId      String
  workspaceId String
  tokenHash   String   @unique
  remember    Boolean  @default(false)
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([workspaceId, expiresAt])
}

model RememberSession {
  id          String   @id @default(cuid())
  agentId      String
  workspaceId String
  tokenHash   String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([workspaceId, expiresAt])
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     PlatformSession[]
  rememberSessions PlatformRememberSession[]
  userSecurityAuditLogs UserSecurityAuditLog[]
}

model PlatformSession {
  id         String        @id @default(cuid())
  adminId    String
  tokenHash  String        @unique
  expiresAt  DateTime
  lastUsedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model PlatformRememberSession {
  id         String        @id @default(cuid())
  adminId    String
  tokenHash  String        @unique
  expiresAt  DateTime
  lastUsedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model PlatformConfig {
  id                String   @id @default("platform")
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean  @default(false)
  smtpUser          String?
  smtpPass          String?
  smtpFrom          String?
  supportEmail      String?
  emailBrandName    String?
  emailBrandTagline String?
  billplzApiKey     String?
  billplzXSignatureKey String?
  billplzCollectionId String?
  billplzSandbox    Boolean  @default(false)
  metaAppId         String?
  metaAppSecret     String?
  metaConfigId      String?
  metaGraphVersion  String?
  metaRedirectUri   String?
  metaWebhookVerifyToken String?
  automationWorkflowIdleHours   Int      @default(24)
  automationWorkflowExpireHours Int      @default(72)
  freeTrialDurationDays          Int      @default(14)
  expiredAccountCleanupDays      Int      @default(60)
  sessionTimeoutMinutes          Int      @default(60)
  rememberMeTimeoutMinutes       Int      @default(43200)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  packageConfigs    PlatformPackageConfig[]
}

model PlatformPackageConfig {
  id                  String         @id @default(cuid())
  platformId          String         @default("platform")
  packageKey          String         @unique
  isVisible           Boolean        @default(true)
  displayOrder        Int            @default(0)
  priceAmount         Decimal?       @db.Decimal(10, 2)
  yearlyDiscountPercentage Decimal   @default(0) @db.Decimal(5, 2)
  mediaLibraryStorageLimitBytes BigInt?
  maxOutboundMessages Int?
  maxActiveContacts   Int?
  maxActiveAutomations Int?
  maxWhatsAppCampaigns Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  platform            PlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId, displayOrder])
}

model Package {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  priceAmount   Decimal? @db.Decimal(10, 2)
  currency      String?
  billingPeriod BillingPeriod?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions WorkspacePackageSubscription[]
}

model WorkspacePackageSubscription {
  id              String             @id @default(cuid())
  workspaceId     String
  packageId       String
  status          SubscriptionStatus
  subscribedPrice Decimal?           @db.Decimal(10, 2)
  currency        String?
  billingPeriod   BillingPeriod?
  startedAt       DateTime
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  endedAt         DateTime?
  nextBillingAt   DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  autoRenew       Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  package         Package            @relation(fields: [packageId], references: [id])
  transactions    PaymentTransaction[]
  invoices        Invoice[]
  emailLogs       EmailLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, startedAt])
  @@index([packageId])
}

model EmailLog {
  id             String   @id @default(cuid())
  workspaceId     String
  subscriptionId  String?
  eventKey        String   @unique
  emailType       String
  recipientEmail  String
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace      Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription   WorkspacePackageSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([subscriptionId])
}

model UserSecurityAuditLog {
  id          String        @id @default(cuid())
  agentId     String
  adminId     String?
  eventType   String
  metadataJson String?
  createdAt   DateTime      @default(now())
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  admin       PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model WorkspaceBillingProfile {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  billingName      String
  billingEmail     String
  contactNumber    String
  billingAddress1  String   @default("")
  billingAddress2  String?
  billingCity      String   @default("")
  billingState     String   @default("")
  billingPostcode  String   @default("")
  billingCountry   String   @default("Malaysia")
  taxNumber        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                   String        @id @default(cuid())
  invoiceNo            String        @unique
  orderNo              String        @unique
  workspaceId          String
  subscriptionId       String?
  packageId            String?
  customerName         String
  customerEmail        String
  customerInformation  String?
  packageName          String
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("MYR")
  status               InvoiceStatus @default(PAID)
  transactionType      String
  subscriptionStartDate DateTime
  subscriptionEndDate  DateTime?
  paymentDate          DateTime?
  receiptNumber        String?       @unique
  receiptIssuedAt      DateTime?
  companyInformation   String?
  taxInformation       String?
  pdfPath              String?
  issueDate            DateTime      @default(now())
  dueDate              DateTime?
  totalAmount          Decimal?      @db.Decimal(10, 2)
  paidAmount           Decimal?      @db.Decimal(10, 2)
  balanceAmount        Decimal?      @db.Decimal(10, 2)
  invoicePdfPath       String?
  receiptPdfPath       String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace     Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription  WorkspacePackageSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  histories     BillingHistory[]
  paymentTransactions PaymentTransaction[]

  @@index([workspaceId, createdAt])
  @@index([subscriptionId])
  @@index([receiptIssuedAt])
}

model BillingHistory {
  id              String   @id @default(cuid())
  workspaceId     String
  invoiceId       String?
  transactionType String
  description     String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("MYR")
  trialStartDate  DateTime?
  trialEndDate    DateTime?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([invoiceId])
}

model PendingWorkspacePackageUpgrade {
  id                  String   @id @default(cuid())
  workspaceId         String
  requestedByAgentId  String
  invoiceNumber       String   @unique
  currentPlan         String
  targetPlan          String
  operationType       String?
  billingPeriod       BillingPeriod?
  provider            String?
  providerReference   String?  @unique
  providerCheckoutUrl String?
  amount              Decimal? @db.Decimal(10, 2)
  currency            String?
  status              String   @default("ISSUED")
  replacedById        String?
  replacesId          String?
  replacementReason   String?
  paymentStartedAt    DateTime?
  paidAt              DateTime?
  receiptNumber       String?  @unique
  receiptIssuedAt     DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByAgent    Agent     @relation(fields: [requestedByAgentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([requestedByAgentId, createdAt])
}

model PaymentTransaction {
  id                String                 @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  invoiceId         String?
  transactionId     String?                @unique
  amount            Decimal                @db.Decimal(10, 2)
  currency          String                 @default("MYR")
  status            PaymentStatus
  provider          String?
  providerReference String?
  paymentMethod     String?
  receiptNumber     String?                @unique
  receiptIssuedAt   DateTime?
  failureReason     String?
  gatewayResponseJson String?
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  subscription      WorkspacePackageSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice           Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, status])
  @@index([workspaceId, createdAt])
  @@index([provider, providerReference])
  @@index([invoiceId])
  @@index([status, paidAt])
}

model ReceiptNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingWorkspaceCheckout {
  id                  String   @id @default(cuid())
  plan                String
  billingPeriod       BillingPeriod?
  name                String
  email               String
  workspaceName       String
  passwordHash        String
  billingName         String   @default("")
  billingPhoneNumber  String   @default("")
  billingAddressLine1 String   @default("")
  billingAddressLine2 String?
  billingCity         String   @default("")
  billingState        String   @default("")
  billingPostcode     String   @default("")
  billingCountry      String   @default("Malaysia")
  billingTaxId        String?
  remember            Boolean  @default(false)
  provider            String?
  providerReference   String?  @unique
  providerCheckoutUrl String?
  status              String   @default("PENDING")
  paidAt              DateTime?
  completedAt         DateTime?
  workspaceId         String?
  agentId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  agentId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model LoginChallengeUse {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        AgentRole @default(AGENT)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   Agent     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model Contact {
  id              String   @id @default(cuid())
  workspaceId     String
  ownerId         String?
  displayName     String
  syncedDisplayName String?
  displayNameManualOverride Boolean @default(false)
  phone           String
  photoUrl        String?
  email           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  emailManualOverride Boolean @default(false)
  status          ContactStatus @default(ACTIVE)
  isHotLead       Boolean  @default(false)
  tags            String
  syncedTags      String?
  tagsManualOverride Boolean @default(false)
  lastInteractionAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           Agent?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teammates       ContactTeammate[]
  conversations   Conversation[]
  campaignRecipients CampaignRunRecipient[]
  leads           Lead[]
  notes           Note[]
  appointments    Appointment[]

  @@index([workspaceId, lastInteractionAt])
  @@index([ownerId])
  @@unique([workspaceId, phone])
}

model Conversation {
  id                String   @id @default(cuid())
  workspaceId       String
  channelId         String?
  contactId         String
  assigneeId        String?
  snoozedById       String?
  whatsAppRemoteId  String?
  subject           String?
  status            ConversationStatus @default(OPEN)
  snoozedUntil      DateTime?
  snoozeReason      String?
  snoozeStatus      ConversationSnoozeStatus?
  isMuted           Boolean  @default(false)
  muteExpiration    DateTime?
  isArchived        Boolean  @default(false)
  isPinned          Boolean  @default(false)
  unreadCount       Int      @default(0)
  isHotLead         Boolean  @default(false)
  lastMessagePreview String?
  lastMessageAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel           WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contact           Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee          Agent? @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  snoozedBy         Agent? @relation("ConversationSnoozedBy", fields: [snoozedById], references: [id], onDelete: SetNull)
  teammates         ConversationTeammate[]
  messages          Message[]
  notes             Note[]
  appointments      Appointment[]
  automationState   ConversationAutomationState?
  ruleExecutions    ConversationRuleExecution[]
  automationJobs    AutomationJob[]
  outboundMessageJobs OutboundMessageJob[]
  campaignRecipients CampaignRunRecipient[]
  auditEvents       ConversationAuditEvent[]
  whatsAppMessageEnvelopes WhatsAppMessageEnvelope[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, snoozeStatus, snoozedUntil, lastMessageAt])
  @@index([channelId, status, lastMessageAt])
  @@index([contactId])
  @@index([assigneeId])
  @@index([snoozedById])
  @@index([whatsAppRemoteId])
}

model ContactTeammate {
  contactId  String
  agentId    String
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([contactId, agentId])
  @@index([agentId])
}

model ContactImport {
  id                String                         @id @default(cuid())
  workspaceId       String                         @map("workspace_id")
  uploadedById      String                         @map("uploaded_by")
  originalFilename  String                         @map("original_filename")
  storedFilename    String                         @map("stored_filename")
  storagePath       String?                        @map("storage_path")
  totalRows         Int                            @map("total_rows")
  importedRows      Int                            @map("imported_rows")
  skippedRows       Int                            @default(0) @map("skipped_rows")
  failedRows        Int                            @map("failed_rows")
  status            ContactImportStatus
  duplicateBehavior ContactImportDuplicateBehavior @default(SKIP) @map("duplicate_behavior")
  uploadedAt        DateTime                       @default(now()) @map("uploaded_at")
  workspace         Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy        Agent                          @relation("ContactImportUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  logs              ContactImportLog[]

  @@index([workspaceId, uploadedAt])
  @@index([uploadedById, uploadedAt])
  @@map("contact_imports")
}

model ContactImportLog {
  id           String               @id @default(cuid())
  importId     String               @map("import_id")
  rowNumber    Int                  @map("row_number")
  name         String?
  phone        String?
  status       ContactImportLogStatus
  errorMessage String?              @map("error_message")
  createdAt    DateTime             @default(now()) @map("created_at")
  contactImport ContactImport       @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowNumber])
  @@index([status, createdAt])
  @@map("contact_import_logs")
}

model ConversationTeammate {
  conversationId String
  agentId        String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([conversationId, agentId])
  @@index([agentId])
}

model ConversationAuditEvent {
  id             String                     @id @default(cuid())
  workspaceId    String
  conversationId String
  actorId        String
  type           ConversationAuditEventType
  fromAssigneeId String?
  toAssigneeId   String?
  createdAt      DateTime                   @default(now())
  workspace      Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
